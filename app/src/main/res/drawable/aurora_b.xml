<?xml version="1.0" encoding="utf-8"?>
<!-- "Breathing" light: a soft white blob that drifts and swells. Tinted per track; shown only while playing. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <group android:name="blob" android:pivotX="72" android:pivotY="74">
                <path
                    android:name="glow"
                    android:pathData="M72,74m-32,0a32,32 0,1 1,64,0a32,32 0,1 1,-64,0">
                    <aapt:attr name="android:fillColor">
                        <gradient android:centerX="72" android:centerY="74" android:gradientRadius="32" android:type="radial">
                            <item android:color="#FFFFFFFF" android:offset="0" />
                            <item android:color="#59FFFFFF" android:offset="0.5" />
                            <item android:color="#00FFFFFF" android:offset="1" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="blob">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:duration="8300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="translateX" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="12" android:valueTo="-30" android:valueType="floatType" />
                <objectAnimator android:duration="9700" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="translateY" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="8" android:valueTo="-24" android:valueType="floatType" />
                <objectAnimator android:duration="7100" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleX" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="1.2" android:valueTo="0.85" android:valueType="floatType" />
                <objectAnimator android:duration="6400" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="0.9" android:valueTo="1.3" android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="glow">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="6000" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="fillAlpha" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="0.45" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
