<?xml version="1.0" encoding="utf-8"?>
<!-- "Now playing" equalizer: three bars bouncing at different rates. Tinted with the accent; only while playing. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
            <group android:name="bar0" android:pivotY="20">
                <path android:fillColor="#FFFFFFFF" android:pathData="M5,5.5 a1.75,1.75 0,0 1,3.5 0 V18.5 a1.75,1.75 0,0 1,-3.5 0 Z" />
            </group>
            <group android:name="bar1" android:pivotY="20">
                <path android:fillColor="#FFFFFFFF" android:pathData="M10.25,5.5 a1.75,1.75 0,0 1,3.5 0 V18.5 a1.75,1.75 0,0 1,-3.5 0 Z" />
            </group>
            <group android:name="bar2" android:pivotY="20">
                <path android:fillColor="#FFFFFFFF" android:pathData="M15.5,5.5 a1.75,1.75 0,0 1,3.5 0 V18.5 a1.75,1.75 0,0 1,-3.5 0 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="bar0">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="430" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="0" android:valueFrom="0.22" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="560" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="120" android:valueFrom="0.22" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="490" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="scaleY" android:repeatCount="infinite" android:repeatMode="reverse" android:startOffset="60" android:valueFrom="0.22" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
