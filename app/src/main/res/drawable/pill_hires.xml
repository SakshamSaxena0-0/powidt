<?xml version="1.0" encoding="utf-8"?>
<!-- Hi-Res badge: brushed-gold capsule (text is set dark by the renderer). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="100dp" />
    <gradient
        android:angle="315"
        android:centerColor="#FFE2C27A"
        android:endColor="#FFB98A3B"
        android:startColor="#FFF6E3AE" />
    <stroke
        android:width="1dp"
        android:color="#66FFF3D0" />
</shape>
