<?xml version="1.0" encoding="utf-8"?>
<!-- Quick actions (EQ + preset, library, sleep, volume) on the left; format pill and like on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meta_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_eq"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_eq"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eq"
            android:layout_marginStart="-5dp" />

        <TextView
            android:id="@+id/eq_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/pill_glass"
            android:contentDescription="@string/cd_eq_next"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="96dp"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_library"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_library"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_library" />
        <ImageView
            android:id="@+id/btn_sleep"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_sleep"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_moon" />
        <ImageView
            android:id="@+id/btn_vol_down"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_vol_down"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vol_down" />
        <ImageView
            android:id="@+id/btn_vol_up"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/cd_vol_up"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_vol_up" />

        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/spec_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_glass"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_favorite"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/cd_favorite"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="-4dp" />
</LinearLayout>
